# ── AI Provider (Groq) ────────────────────────────────────────────
# Server-side only. NEVER exposed to the browser (no NEXT_PUBLIC_ prefix).
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# ── GitHub JSON data store ───────────────────────────────────────
GITHUB_TOKEN=
GITHUB_OWNER=your-org-or-username
GITHUB_REPO=emojiforge-ai-data
GITHUB_BRANCH=main

# ── Admin auth (MVP; swap for Auth.js/Clerk/Supabase later) ─────
ADMIN_EMAIL=admin@example.com
ADMIN_SECRET=change-me-to-a-long-random-string
SESSION_SECRET=change-me-to-a-32-byte-random-string

# ── Cache / matching tuning ──────────────────────────────────────
SEMANTIC_CACHE_ENABLED=false
SEMANTIC_CACHE_THRESHOLD=0.88
FUZZY_MATCH_THRESHOLD=0.86

# ── GitHub write queue ────────────────────────────────────────────
GITHUB_BATCH_INTERVAL_MS=300000
GITHUB_MAX_BATCH_SIZE=50

# ── Rate limiting ─────────────────────────────────────────────────
RATE_LIMIT_GENERATE_PER_MIN=6
RATE_LIMIT_PUBLIC_PER_MIN=60
RATE_LIMIT_ADMIN_PER_MIN=120

NODE_ENV=development
